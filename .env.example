# 复制本文件为 .env。不要将真实密钥提交到版本库。
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=streamer_sales_db

LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL_NAME=deepseek-flash

# 使用 `openssl rand -hex 32` 生成。
TOKEN_JWT_SECURITY_KEY=replace-with-at-least-32-random-bytes

# 仅在数据库没有用户时用于创建首个管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

ENABLE_RAG=true
ENABLE_TTS=false
ENABLE_DIGITAL_HUMAN=false
ENABLE_ASR=false
ENABLE_AGENT=false

# 微信 AppID 必须与 miniprogram/manifest.json 一致；密钥仅保存在后端。
WX_APPID=
WX_SECRET=
ALLOW_DEV_LOGIN=false

# 海报生成动作：阿里云百炼北京地域密钥，仅保存在后端。
DASHSCOPE_API_KEY=
MOTION_API_BASE=https://dashscope.aliyuncs.com/api/v1

# 多数字人应用密钥通过管理员后台逐个绑定，加密保存到数据库。
# 小程序 WebView 对应的 HTTPS 网页域名，需在微信公众平台配置业务域名。
XINGYUN_WEB_ORIGIN=
