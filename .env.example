# 复制本文件为 .env。不要将真实密钥提交到版本库。
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=streamer_sales_db

LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL_NAME=deepseek-flash

# 使用 `openssl rand -hex 32` 生成。
TOKEN_JWT_SECURITY_KEY=replace-with-at-least-32-random-bytes

# 仅在数据库没有用户时用于创建首个管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

ENABLE_RAG=true
ENABLE_TTS=false
ENABLE_DIGITAL_HUMAN=false
# ENABLE_ASR 只控制旧的本地 FunASR 微服务（server/asr）。游客端语音走下面的
# DASHSCOPE_API_KEY 云端识别，不需要开启此项。
ENABLE_ASR=false
ENABLE_AGENT=false

# 邮箱注册验证码：QQ 邮箱开启 SMTP 后生成授权码，不是 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=3072125674@qq.com
SMTP_PASSWORD=

# 拍照识景（可复用 DASHSCOPE_API_KEY；需开通对应视觉模型）。
VISION_API_KEY=
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
# 语音识别（ASR）的音频转换工具路径；不填时依次查找
# weights/digital_human_weights/drivers/ffmpeg.exe 和系统 PATH。缺少时语音识别会明确报错。
FFMPEG_PATH=

# 阿里云百炼密钥，仅保存在后端。同时用于海报生成动作（wan2.2-i2v-plus）、
# 游客语音识别（qwen3-asr-flash）和拍照识景（未单独配置 VISION_API_KEY 时）。
DASHSCOPE_API_KEY=
MOTION_API_BASE=https://dashscope.aliyuncs.com/api/v1

# 多数字人应用密钥通过管理员后台逐个绑定，加密保存到数据库。
# 同一个角色可再建一个英文音色应用：界面切英文时走这套凭据，展示仍是同一个人物。
# 填了就每次启动写入默认导游的绑定；平时也可以只在后台「英文应用（可选）」里填。
XINGYUN_APP_ID_EN=
XINGYUN_APP_SECRET_EN=
# 英文音色名称，仅用于后台/游客端显示，例如 "English female"。
XINGYUN_VOICE_EN=
# 小程序 WebView 对应的 HTTPS 网页域名。
XINGYUN_WEB_ORIGIN=

# 可选：仅 Edge-TTS 使用的代理，例如本机已有代理；为空则直连。
EDGE_TTS_PROXY=
