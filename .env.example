# 复制本文件为 .env。不要将真实密钥提交到版本库。
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=streamer_sales_db

LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=replace-with-your-provider-key
LLM_MODEL_NAME=deepseek-flash

# 使用 `openssl rand -hex 32` 生成。
TOKEN_JWT_SECURITY_KEY=replace-with-at-least-32-random-bytes

# 仅在数据库没有用户时用于创建首个管理员。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

ENABLE_RAG=true
ENABLE_TTS=false
ENABLE_DIGITAL_HUMAN=false
ENABLE_ASR=false
ENABLE_AGENT=false

# 微信 AppID 必须与 miniprogram/manifest.json 一致；密钥仅保存在后端。
WX_APPID=
WX_SECRET=
ALLOW_DEV_LOGIN=false

# 邮箱注册验证码：QQ 邮箱开启 SMTP 后生成授权码，不是 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=3072125674@qq.com
SMTP_PASSWORD=

# 拍照识景（可复用 DASHSCOPE_API_KEY；需开通对应视觉模型）。
VISION_API_KEY=
VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
# 语音识别的音频转换工具路径；不填时搜索 PATH。
FFMPEG_PATH=

# 海报生成动作：阿里云百炼北京地域密钥，仅保存在后端。
DASHSCOPE_API_KEY=
MOTION_API_BASE=https://dashscope.aliyuncs.com/api/v1

# 多数字人应用密钥通过管理员后台逐个绑定，加密保存到数据库。
# 小程序 WebView 对应的 HTTPS 网页域名，需在微信公众平台配置业务域名。
XINGYUN_WEB_ORIGIN=

# 可选：填写以下两项，首次启动自动创建并上架默认数字人。
# 后续管理端可增删改；删除或下架后重启不会恢复，不会覆盖管理端修改。
XINGYUN_APP_ID=
XINGYUN_APP_SECRET=
XINGYUN_DEFAULT_GUIDE_NAME=默认星云导游
XINGYUN_DEFAULT_GUIDE_CHARACTER=
XINGYUN_DEFAULT_GUIDE_AVATAR=
XINGYUN_DEFAULT_GUIDE_POSTER=
XINGYUN_DEFAULT_GUIDE_VOICE=

# iFLYTEK digital human: WeChat mini program only; keep Xingyun for App.
IFLYTEK_AVATAR_APP_ID=
IFLYTEK_AVATAR_API_KEY=
IFLYTEK_AVATAR_API_SECRET=
IFLYTEK_AVATAR_SCENE_ID=

# Reuse the configured vision provider for tour text responses.
TOUR_LLM_USE_VISION_PROVIDER=false

# 微信小程序讯飞实时数字人（服务端配置，不得写入小程序包）
XFYUN_AVATAR_APP_ID=
XFYUN_AVATAR_API_KEY=
XFYUN_AVATAR_API_SECRET=
XFYUN_AVATAR_AVATAR_ID=
XFYUN_AVATAR_VCN=
